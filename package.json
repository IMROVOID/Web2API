{
  "name": "web2api-proxy",
  "version": "1.0.0",
  "description": "Universal OpenAI-compatible reverse proxy for web chat interfaces (FreeModels.Pro) with agent tool calling support",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "web2api": "dist/cli.js",
    "web2api-proxy": "dist/cli.js"
  },
  "files": [
    "dist",
    "worker.js",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/cli/index.ts start",
    "start": "tsx src/cli/index.ts start",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "deploy": "wrangler deploy"
  },
  "keywords": [
    "openai",
    "reverse-proxy",
    "agent",
    "tool-calling",
    "cloudflare-workers",
    "freemodels",
    "claude-code",
    "cursor",
    "cline",
    "hono"
  ],
  "author": "IMROVOID",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IMROVOID/Web2API.git"
  },
  "bugs": {
    "url": "https://github.com/IMROVOID/Web2API/issues"
  },
  "homepage": "https://github.com/IMROVOID/Web2API#readme",
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.13.9",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "wrangler": "^3.111.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
